# Copy this file to .env and fill in your SQL Server details.

PORT=4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Public address of the frontend, used in the signing links emailed to signers.
# Leave empty in development: links use the frontend address the request came from.
APP_URL=

# --- MS SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
# An existing database; the tables are created inside DB_SCHEMA
DB_NAME=EFimo_V5_Dev
DB_SCHEMA=eSign
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
# Named instance (e.g. SQLEXPRESS). Leave empty when using DB_PORT.
DB_INSTANCE=
# true for Azure SQL; false is fine for a local server
DB_ENCRYPT=false
# true for local servers with a self-signed certificate
DB_TRUST_SERVER_CERTIFICATE=true

# --- Email (OTP codes for login / signup) ---
# Leave SMTP_HOST empty during development: codes are printed in the backend console instead.
# Office 365: smtp.office365.com / 587 / SMTP_SECURE=false   Gmail: smtp.gmail.com / 465 / SMTP_SECURE=true (app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=eSign Doc Builder <no-reply@yourcompany.com>
OTP_EXPIRY_MINUTES=5

# --- Translation (Review > Translate in the template editor) ---
# Google Cloud Translation API key (console.cloud.google.com > APIs > Cloud Translation API > Credentials).
# Leave empty to use Google's free public endpoint: fine for development, but rate-limited and unofficial.
GOOGLE_TRANSLATE_API_KEY=

# --- Auth ---
# Use a long random string in production, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
