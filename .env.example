# Copy this file to .env and fill in your SQL Server details.

PORT=4000
# development | production (production warns about missing settings)
NODE_ENV=development

# --- Addresses (change these when you deploy) ---
# Public address of the site, used in every signing link emailed to signers. No trailing slash.
#   Development: leave empty (links use the frontend that made the request, e.g. http://localhost:5173)
#   Deployed:    APP_URL=https://esign.yourcompany.com
APP_URL=
# Comma-separated frontend origins allowed to call the API from a browser.
#   Development: http://localhost:5173
#   Deployed:    https://esign.yourcompany.com   (only needed when the site and the API are on different addresses)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Proxy in front of the API (nginx, IIS, load balancer), so the audit trail records the signer's real IP.
#   loopback = proxy on the same machine (default) | 1 = one proxy hop | false = no proxy
TRUST_PROXY=loopback
# Optional: serve the built frontend from this API too (one process, one address). Path to the frontend's dist folder.
#   FRONTEND_DIST=../Esign_doc_builder/dist
FRONTEND_DIST=
# Branding used on every page of the Audit Trail PDF.
AUDIT_TRAIL_LOGO_URL=http://172.18.2.34:3404/assets/jayam-logo-new-OSmOLy-P.png
AUDIT_TRAIL_SUBTITLE=Jayam Solutions Ltd

# --- MS SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
# An existing database; the tables are created inside DB_SCHEMA
DB_NAME=EFimo_V5_Dev
DB_SCHEMA=eSign
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
# Named instance (e.g. SQLEXPRESS). Leave empty when using DB_PORT.
DB_INSTANCE=
# true for Azure SQL; false is fine for a local server
DB_ENCRYPT=false
# true for local servers with a self-signed certificate
DB_TRUST_SERVER_CERTIFICATE=true

# --- Email (OTP codes for login / signup) ---
# Leave SMTP_HOST empty during development: codes are printed in the backend console instead.
# Office 365: smtp.office365.com / 587 / SMTP_SECURE=false   Gmail: smtp.gmail.com / 465 / SMTP_SECURE=true (app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=eSign Doc Builder <no-reply@yourcompany.com>
OTP_EXPIRY_MINUTES=5

# --- Translation (Review > Translate in the template editor) ---
# Google Cloud Translation API key (console.cloud.google.com > APIs > Cloud Translation API > Credentials).
# Leave empty to use Google's free public endpoint: fine for development, but rate-limited and unofficial.
GOOGLE_TRANSLATE_API_KEY=

# --- Auth ---
# Use a long random string in production, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Signing methods ---
# sandbox = Aadhaar eSign and DSC are imitated (test mode); live = needs a licensed ESP and token utility
ESIGN_MODE=sandbox

# --- Address of the signer's GPS location ---
# nominatim = OpenStreetMap (free, max 1 lookup a second) | google = needs GOOGLE_MAPS_API_KEY | off
GEOCODER=nominatim
GOOGLE_MAPS_API_KEY=
