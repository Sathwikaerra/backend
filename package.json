{
  "name": "esign-doc-builder-api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "REST API for eSign Doc Builder (Express + MS SQL Server)",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:migrate": "node src/scripts/migrate.js",
    "mail:test": "node src/scripts/mailTest.js",
    "db:seed": "node src/scripts/seed.js",
    "pdf:base64": "node src/scripts/pdfToBase64.js"
  },
